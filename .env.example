# ============================================================
# 小厨 · 配置模板 (复制为 .env 使用; 真实 .env 已被 .gitignore 忽略)
# 分类原则:
#   - GitHub 仓库       = 源代码 + 本模板
#   - 本地/服务器 Secret = DeepSeek key, Supabase Secret key, AUTO_PASSWORD,
#                          PUBLISH_SECRET —— 永不进仓库、永不进 APK、永不出现在聊天截图/文档
# ============================================================

# ---------- Supabase 项目 (值可公开) ----------
SUPABASE_URL=https://juxlfhrgywurttzzxgvr.supabase.co
# publishable key: Dashboard → Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_替换为你的key

# ---------- 服务器 Secret (Supabase Dashboard → Edge Functions → Secrets) ----------
# DeepSeek key: 只配置为 Edge Secret DEEPSEEK_API_KEY; AI 调用走服务端代理
# ⚠️ 严禁写入 APK / local.properties / build.gradle / 任何前端文件
DEEPSEEK_API_KEY=sk-替换为你的key
# Supabase Secret key (服务端脚本/管理用途; 注意: 浏览器与客户端请求会被 Supabase 拒绝)
SUPABASE_SECRET_KEY=sb_secret_替换为你的key
# 热更新发布门: 与 Edge Secret PUBLISH_SECRET 一致; publish.mjs 通过环境变量/参数传入
PUBLISH_SECRET=<随机长串>

# ---------- 本地构建 (Android, 对应 android/local.properties) ----------
AI_MODE=edge
AUTO_EMAIL=xiaochu.family@example.com
AUTO_PASSWORD=<替换为你的密码>
