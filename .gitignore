# ============================================================
# 小厨 · .gitignore —— 白名单之外的任何东西都不准进仓库
# 分类: 本地 Secret / 构建产物 / 发布产物 / 会话与备份
# ============================================================

# ---------- 本地 Secret / 凭证 (最高优先级) ----------
.env
*.env
!.env.example
android/local.properties
*.jks
*.keystore
*.p12
app/secrets.json

# ---------- Android 构建 ----------
android/.gradle/
android/**/build/
android/build/
android/app/build/
android/app/release/
android/.idea/
android/*.iml
android/captures/
android/.kotlin/
android/local.properties

# ---------- Flutter 版本 (保留参考) ----------
app/.dart_tool/
app/build/
app/secrets.json

# ---------- 发布产物 (走发布站/共享盘, 不入库) ----------
*.apk
*.aab
backups/
xiaochu-release/

# ---------- 后端 / 工具 ----------
backend/supabase/.temp/
backend/supabase/.branches/
node_modules/
*.log
*.log.*

# ---------- 冻结模块的大二进制（2026-09-04: 模型移出 git，工作树保留；克隆不携带 65MB） ----------
# :speech 模块未被 :app 依赖（不进 APK）；模型完整副本见 D:\work2\android-local-speech-recognition\assets\
android/speech/src/main/assets/vosk-model-small-cn-0.22/

# ---------- 会话与杂项 ----------
.session_restore/
.idea/
*.iml
Thumbs.db
.DS_Store
